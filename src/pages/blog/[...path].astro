---
import dayjs from 'dayjs';
import BlogLayout from '../../blog/layouts/BlogLayout.astro';
import ArticleToc from '../../blog/components/ArticleToc.astro';
import AuthorBox from '../../blog/components/AuthorBox.astro';
import BlogBreadcrumb from '../../blog/components/BlogBreadcrumb.astro';
import KeepReading from '../../blog/components/KeepReading.astro';
import RelatedPosts from '../../blog/components/RelatedPosts.astro';
import TagList from '../../blog/components/TagList.astro';
import type { BlogArticle, BlogArticleListing } from '../../blog/interfaces/article.ts';
import { fetchAllArticles } from '../../blog/api/blogApi.ts';
import { getBlogCategoryByDrupalName, type BlogCategory } from '../../blog/categories.ts';
import { getBlogArticlePath, getBlogCategoryPath } from '../../blog/routes.ts';
import { buildArticleToc } from '../../blog/utils/articleToc.ts';
import { getDrupalFeaturedCategoryPosts, resolveFeaturedCategoryPost } from '../../blog/utils/categoryDiscovery.ts';
import { getReadingTime } from '../../blog/utils/readingTime.ts';
import { getRelatedPosts, normalizeSecondaryCategories } from '../../blog/utils/tags.ts';

export async function getStaticPaths() {
  const response = await fetchAllArticles({ fieldSet: 'full' });
  const articles = response.articles.items;
  return articles.map((article) => {
    const category = getBlogCategoryByDrupalName(article.category, article.title);
    const canonicalPath = getBlogArticlePath(category, article.slug, article.title);
    return {
      params: { path: canonicalPath.slice('/blog/'.length, -1) },
      props: {
        article,
        category,
        canonicalPath,
        relatedPosts: getRelatedPosts(article, articles),
        featuredPost: resolveFeaturedCategoryPost(articles, category, getDrupalFeaturedCategoryPosts(articles, category)),
      },
    };
  });
}

const { article, category, canonicalPath, relatedPosts, featuredPost } = Astro.props as {
  article: BlogArticle;
  category: BlogCategory;
  canonicalPath: string;
  relatedPosts: BlogArticleListing[];
  featuredPost?: BlogArticleListing;
};
const processed = buildArticleToc(article.content);
const tags = normalizeSecondaryCategories(article.secondaryCategories);
const imageCredits = article.imageCredits?.trim();
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.title,
  description: article.metaDescription,
  image: article.mainImage,
  url: new URL(canonicalPath, Astro.site).toString(),
  datePublished: article.date,
  author: { '@type': 'Person', name: article.authorName || 'Sanna Kramsi' },
  articleSection: category.label,
};
---

<BlogLayout title={article.title} metaDescription={article.metaDescription} canonicalPath={canonicalPath} image={article.mainImage} articleLayout>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <BlogBreadcrumb slot="breadcrumb" items={[{ label: 'Blog', href: '/blog/' }, ...(category.group === 'personal' ? [{ label: 'Personal', href: '/blog/personal/' }] : []), { label: category.label, href: getBlogCategoryPath(category) }, { label: article.title }]} />
  <article class="min-w-0">
    <h1 class="text-3xl font-bold lg:text-4xl">{article.title}</h1>
    <p class="mt-3 text-base">{dayjs(article.date).format('MMMM DD, YYYY')} <span aria-hidden="true">|</span> {category.label} <span aria-hidden="true">|</span> {getReadingTime(article.content)}</p>
    <TagList tags={tags} />
    <ArticleToc items={processed.items} />
    {article.boxContent && <aside class="my-8 border-4 border-lt-code-border bg-lt-code-bg p-6 dark:border-dk-code-border dark:bg-dk-code-bg"><h2 class="m-0">{article.boxTitle}</h2><div class="blog-body"><Fragment set:html={article.boxContent} /></div></aside>}
    <div class="blog-body"><Fragment set:html={processed.content} /></div>
    {imageCredits && <div class="mt-8 text-base"><Fragment set:html={`Image credit: ${imageCredits}`} /></div>}
  </article>
  <aside slot="sidebar" class="space-y-6">
    <AuthorBox authorName={article.authorName} authorImage={article.authorImage} authorContent={article.authorContent} />
    <KeepReading category={category} currentSlug={article.slug} featuredPost={featuredPost} relatedPosts={relatedPosts} />
  </aside>
  <RelatedPosts slot="related" posts={relatedPosts} />
</BlogLayout>
