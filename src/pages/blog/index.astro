---
import { Icon } from 'astro-icon/components';
import BlogLayout from '../../blog/layouts/BlogLayout.astro';
import CategoryCard from '../../blog/components/CategoryCard.astro';
import PostGrid from '../../blog/components/PostGrid.astro';
import { blogCategories } from '../../blog/categories.ts';
import { fetchArticles, fetchPageContent } from '../../blog/api/blogApi.ts';
import { getDrupalFeaturedCategoryPosts, resolveFeaturedCategoryPost } from '../../blog/utils/categoryDiscovery.ts';

const [frontContent, articleResponse] = await Promise.all([
  fetchPageContent(1),
  fetchArticles({ limit: 101, fieldSet: 'listing' }),
]);
const allPosts = articleResponse.articles.items;
const professionalCategories = blogCategories.filter((category) => category.group === 'professional');
---

<BlogLayout title={frontContent.page.title} metaDescription={frontContent.page.metaDescription} canonicalPath="/blog/">
  <header class="mx-auto max-w-4xl text-center">
    <h1 class="text-4xl font-bold md:text-6xl">{frontContent.page.title}</h1>
    <div class="blog-body mt-4"><Fragment set:html={frontContent.page.content} /></div>
  </header>
  <section aria-label="Blog topics">
    <div class="grid gap-5 md:grid-cols-2">
      {professionalCategories.map((category) => <CategoryCard category={category} featuredPost={resolveFeaturedCategoryPost(allPosts, category, getDrupalFeaturedCategoryPosts(allPosts, category))} />)}
      <CategoryCard href="/blog/personal/" label="Personal" description="Life, cats, games, and other personal subjects that may join them later." />
    </div>
  </section>
  <section aria-labelledby="latest-posts"><h2 id="latest-posts" class="mb-5 text-center text-3xl">Latest posts</h2><PostGrid posts={allPosts.slice(0, 6)} headingLevel={3} /><p class="mt-6 text-center"><a href="/blog/posts/" class="blog-button inline-flex items-center gap-2 px-5 py-3 text-base font-semibold no-underline">Browse all posts <Icon name="arrow-right" class="browse-all-posts-arrow h-6 w-6 shrink-0" aria-hidden="true" /></a></p></section>
</BlogLayout>

<style>
  .browse-all-posts-arrow {
    transition: transform 150ms ease-in-out;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .blog-button:hover .browse-all-posts-arrow {
      transform: translateX(2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .browse-all-posts-arrow {
      transition: none;
    }
  }
</style>
