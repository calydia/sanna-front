---

<Card
  title="Esiintymiset"
  metaDescription="Sanna Kramsin puheenvuorot ja esitykset saavutettavuudesta."
  language="fi"
  pageType="sub"
  fiUrl="/fi/esiintymiset/"
  enUrl="/speaking/"
>
  <IntroPage
    title="Esiintymiset"
    description="Puhun saavutettavuudesta, inklusiivisesta suunnittelusta, saavutettavasta frontend-kehityksestä ja siitä, miten tiimit ylläpitävät saavutettavuutta pitkällä aikavälillä."
  />

  <section aria-labelledby="esiintymisaiheet-heading">
    <h2 id="esiintymisaiheet-heading" class="mb-4">Aiheet, joista puhun</h2>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      {topics.map((topic) => (
        <article class="rounded-2xl border border-white/50 bg-white/95 p-6 shadow-lg dark:border-black/20 dark:bg-black/40">
          <h3 class="text-lg">{topic.title}</h3>
          <p class="mt-3 leading-relaxed text-gray-700 dark:text-gray-300">{topic.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section aria-labelledby="tulevat-esiintymiset-heading">
    <h2 id="tulevat-esiintymiset-heading" class="mb-4">Tulevat esiintymiset</h2>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {upcomingTalks.map((talk) => <TalkCard {...talk} />)}
    </div>
  </section>

  <div class="grid grid-cols-1 items-start gap-4 lg:grid-cols-[minmax(0,1.4fr)_minmax(15rem,0.6fr)]">
    <section aria-labelledby="aiemmat-esiintymiset-heading" class="rounded-2xl border border-white/50 bg-white/95 p-6 shadow-lg dark:border-black/20 dark:bg-black/40">
      <h2 id="aiemmat-esiintymiset-heading">Aiemmat esiintymiset</h2>
      <div class="mt-6 space-y-8">
        {pastTalks.map((group) => (
          <section aria-labelledby={`esiintymiset-${group.year}`}>
            <h3 id={`esiintymiset-${group.year}`} class="mb-4">{group.year}</h3>
            <ul>
              {group.talks.map((talk) => (
                <TalkArchiveRow
                  {...talk}
                  recordingLinkText="Katso tallenne"
                  recordingLabelPrefix="Katso tallenne:"
                />
              ))}
            </ul>
          </section>
        ))}
      </div>
    </section>

    <section aria-labelledby="esiintymiskutsut-heading" class="rounded-2xl border border-white/50 bg-white/95 p-6 shadow-lg dark:border-black/20 dark:bg-black/40">
      <h2 id="esiintymiskutsut-heading">Kutsu minut puhujaksi</h2>
      <p class="mt-4 leading-relaxed text-gray-700 dark:text-gray-300">
        Olen kiinnostunut konferensseista, saavutettavuustapahtumista, webinaareista ja yhteisötapahtumista.
      </p>
      <div class="mt-6 space-y-3">
        <a href="mailto:sanna@a11y.ing" class="block rounded-xl bg-dk-purple-header px-5 py-3 text-center font-medium text-white hover:opacity-90 focus:outline focus:outline-2 focus:outline-offset-4 focus:outline-black dark:bg-lt-perfume dark:text-black dark:focus:outline-white">Lähetä sähköpostia</a>
        <a href="https://www.linkedin.com/in/sanna-kramsi/" class="block rounded-xl bg-dk-purple-header px-5 py-3 text-center font-medium text-white hover:opacity-90 focus:outline focus:outline-2 focus:outline-offset-4 focus:outline-black dark:bg-lt-perfume dark:text-black dark:focus:outline-white">Ota yhteyttä LinkedInissä</a>
      </div>
    </section>
  </div>
</Card>
