const upcomingTalks = [
  {
    title: 'Decoding Collaboration: Hidden Skills for Diverse Workflows',
    titleLanguage: 'en',
    url: 'https://wpsuomi.fi/',
    date: '2026-10-16',
    displayDate: '16. lokakuuta 2026',
    event: 'WP Suomi 2026',
    location: 'Oulu',
    collaborator: 'Yhdessä Mikaela Kindstedtin kanssa',
    description: 'Onnistunut yhteistyö edellyttää selkeitä rajoja, määriteltyjä odotuksia ja avointa viestintää. Tässä puheenvuorossa tarkastelemme, miten kontekstin vaihtaminen, epäselvät tehtävät ja dokumentoimattomat käytännöt lisäävät kognitiivista kuormaa ja vaikuttavat suoraan kehittäjien tuottavuuteen ja päätöksentekoon. Opit tunnistamaan erilaisia työskentelytapoja ja hyödyntämään niiden täyden potentiaalin. Jotta yhteistyö olisi tehokasta, tunnista ”hiljaisen hyväksynnän” piilevä hinta ja opi antamaan jokaiselle mahdollisuus olla se ”joku”, joka rikkoo hiljaisuuden. Tarkastelemme, miksi on tärkeää tietää, mitä odotamme toisiltamme, missä vastuut ovat ja miten selkeä vastuunkanto ja koodin omistajuus luodaan etenkin tekoälyn tuottaman koodin parissa. Tutustu kanssamme piileviin taitoihin, joiden avulla voit optimoida päivittäistä työnkulkuasi, suojella henkistä kapasiteettiasi ja parantaa yhteistyötäsi muiden kanssa.',
  },
