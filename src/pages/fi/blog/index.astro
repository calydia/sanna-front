---
import Card from '../../../layouts/Card.astro';
---

<Card
  title="Blogi"
  metaDescription="Sannan englanninkielinen blogi käsittelee saavutettavuutta, teknologiaa, puhumista, projekteja ja elämää."
  language="fi"
  pageType="sub"
  fiUrl="/fi/blog/"
  enUrl="/blog/"
>
  <section class="mx-auto max-w-3xl rounded-2xl border border-white/50 bg-white/95 p-6 shadow-lg backdrop-blur dark:border-black/20 dark:bg-black/40">
    <h1>Blogi</h1>
    <div class="mt-4 space-y-4 text-gray-700 dark:text-gray-300">
      <p>
        Kirjoitan englanniksi saavutettavuudesta, teknologiasta, puhumisesta, projekteistani ja henkilökohtaisemmista aiheista.
      </p>
      <p>
        Blogi on tällä hetkellä saatavilla vain englanniksi. Seuraava linkki vaihtaa sivuston kielen englanniksi.
      </p>
      <p>
        <a
          href="/blog/"
          lang="en"
          hreflang="en"
          class="font-semibold text-black underline decoration-2 underline-offset-4 hover:no-underline dark:text-white"
        >
          Read the blog in English
        </a>
      </p>
    </div>
  </section>
</Card>
