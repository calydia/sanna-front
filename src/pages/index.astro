---
import { Image } from 'astro:assets';
import Card from '../layouts/Card.astro';
import CardLink from '../components/CardLink.astro';
---

<Card title="Sanna Kramsi" metaDescription="I work with digital accessibility from code and testing to organisational practices." pageType="front"
	fiUrl="/fi/" enUrl="/"
>
	<section class="flex items-center justify-center ">
		<article class="w-full max-w-lg backdrop-blur rounded-2xl shadow-lg p-6 text-center border 
			border-white/50 bg-white/95 dark:bg-black/40 dark:border-black/20"
		>
			<Image
				src="/sanna.jpg"
				alt=""
				densities={[1.5, 2]}
				width={1503}
				height={1000}
				class="rounded-full size-40 object-cover mx-auto"
			/>

			<h1 id="profile-title" class="mt-4">Sanna Kramsi</h1>
			<p class="text-sm text-lt-gray dark:text-dk-gray mt-1">
				Accessibility specialist, developer, speaker &amp; advocate
			</p>

			<p class="mt-4 text-sm text-gray-700 dark:text-gray-300">
				I work with digital accessibility from code and testing to organisational practices. Through A11ying with Sanna, I create resources, write and speak about making accessibility a practical part of how digital products are built.
			</p>
		</article>
	</section>

	<section class="flex items-center justify-center">
		<article class="w-full max-w-3xl backdrop-blur rounded-2xl shadow-lg p-6
			border border-white/50 bg-white/95 dark:bg-black/40  dark:border-black/20"
		>
			<h2 class="mb-4 text-lg">Learn and practice accessibility</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
				<CardLink url="https://a11y.ing" title="I would if I could" description="A guide to digital accessibility" />
				<CardLink url="https://wcag.a11y.ing" title="Almost, but not quite" description="WCAG and accessibility requirements" />
				<CardLink url="https://testing.a11y.ing/" title="Accessibility Testing Lab" description="Learn accessibility by testing" />
			</div>

			<h2 class="my-4 text-lg">Find me elsewhere</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
				<CardLink url="https://www.linkedin.com/in/sanna-kramsi/" title="LinkedIn" description="Connect with me" />
				<CardLink url="https://www.youtube.com/@A11yingWithSanna" title="YouTube" description="Watch A11ying with Sanna" />
				<CardLink url="https://forms.gle/22RnCg5TQpMyXYPu5" title="Content requests" description="Suggest something I should cover" />
			</div>
		</article>
	</section>
</Card>