---
type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
---

<article class="rounded-2xl border border-white/50 bg-white/95 p-6 shadow-lg dark:border-black/20 dark:bg-black/40">
  <h3 class="text-lg">{title}</h3>
  <p class="mt-3 leading-relaxed text-gray-700 dark:text-gray-300">{description}</p>
</article>
