---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

  const lang = getLangFromUrl(Astro.url);
  const t = useTranslations(lang);

  const currentPage = Astro.props.currentPage;
  const pageType = Astro.props.pageType;
  const language = Astro.props.language || 'en';

  const frontLink = language == 'fi' ? '/fi/' : '/';
  const servicesLink = language == 'fi' ? '/fi/palvelut/' : '/services/';
---
{pageType !== 'front' ?
  <section class="w-full mb-4 max-w-6xl">
    <nav aria-label={ t('breadcrumb-aria') }>
      <ul class="flex flex-wrap">
        <li class="breadcrumb-li text-black dark:text-white">
          <a href={ frontLink } class="text-black dark:text-white underline decoration-1 underline-offset-4 breadcrumb-link hover:decoration-2">{ t('home-link') }</a>
        </li>

        {pageType == 'service' ?
            <li class="breadcrumb-li text-black dark:text-white">
              <a href={ servicesLink } class="text-black dark:text-white underline decoration-1 underline-offset-4 breadcrumb-link hover:decoration-2">{ t('services-link') }</a>
            </li>
          : null
        }
        <li class="text-black dark:text-white">{ currentPage }</li>
      </ul>
    </nav>
  </section>
: null }
