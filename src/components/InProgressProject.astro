---
type Props = {
  title: string;
  status: string;
  language: string;
  description: string;
};

const { title, status, language, description } = Astro.props;
---

<article class="grid gap-5 rounded-2xl border border-white/50 bg-white/95 p-6 shadow-lg dark:border-black/20 dark:bg-black/40 md:grid-cols-[minmax(10rem,0.35fr)_minmax(0,1.65fr)] md:gap-8">
  <p class="border-l-4 border-dk-purple-header pl-4 font-semibold text-dk-purple-header dark:border-lt-perfume dark:text-lt-perfume">
    {status}
    <span class="mt-1 block text-sm font-normal text-gray-600 dark:text-gray-300">{language}</span>
  </p>
  <div>
    <h3 class="text-xl">{title}</h3>
    <p class="mt-3 leading-relaxed text-gray-700 dark:text-gray-300">{description}</p>
  </div>
</article>
