---
import SiteLayout from './SiteLayout.astro';

const { title, metaDescription, pageType, fiUrl, enUrl, language } = Astro.props;
---

<SiteLayout
  title={title}
  metaDescription={metaDescription}
  pageType={pageType}
  fiUrl={fiUrl}
  enUrl={enUrl}
  language={language}
>
  <slot />
</SiteLayout>
