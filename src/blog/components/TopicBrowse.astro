---
import type { BlogTag } from '../interfaces/tag.ts';
import { getBlogTagPath } from '../routes.ts';
const { tags, title = 'Browse by topic' } = Astro.props as { tags: BlogTag[]; title?: string };
---

{tags.length > 0 && <section aria-labelledby="browse-topics" class="border-y-2 border-lt-blue-dark py-4 dark:border-dk-blue-light"><h2 id="browse-topics" class="m-0 text-center text-2xl">{title}</h2><ul class="mt-3 flex flex-wrap justify-center gap-2 p-0" role="list">{tags.map((tag) => <li><a href={getBlogTagPath(tag.slug)} class="blog-tag-link inline-block border border-lt-blue-dark px-3 py-1.5 text-base dark:border-dk-blue-light">{tag.label}</a></li>)}</ul></section>}
