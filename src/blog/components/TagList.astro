---
import type { BlogTag } from '../interfaces/tag.ts';
import { getBlogTagPath } from '../routes.ts';
const { tags, label = 'Topics' } = Astro.props as { tags: BlogTag[]; label?: string };
---

{tags.length > 0 && <div class="mt-4 text-base"><span class="font-semibold">{label}:</span><ul class="ml-2 inline-flex flex-wrap gap-2 p-0" role="list">{tags.map((tag) => <li><a href={getBlogTagPath(tag.slug)} class="inline-block border border-lt-blue-dark px-3 py-1 underline-offset-4 dark:border-dk-blue-light">{tag.label}</a></li>)}</ul></div>}
