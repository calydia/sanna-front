---
import { getBlogCategoriesByGroup } from '../categories.ts';
import { getBlogCategoryPath, PERSONAL_BLOG_PATH } from '../routes.ts';
import { getAriaCurrent, getNavigationState } from '../../utils/navigation.ts';

const currentPath = Astro.url.pathname;
const links = [
  ...getBlogCategoriesByGroup('professional').map((category) => ({
    href: getBlogCategoryPath(category),
    label: category.label,
  })),
  { href: PERSONAL_BLOG_PATH, label: 'Personal' },
];
---

<nav aria-label="Blog topics" class="w-full border-y border-black/20 py-2 dark:border-white/30">
  <ul class="flex flex-wrap justify-center gap-x-5 gap-y-1 p-0 text-lg">
    {links.map((link) => {
      const state = getNavigationState(currentPath, link.href);

      return (
        <li>
          <a
            href={link.href}
            aria-current={getAriaCurrent(state)}
            class:list={[
              'blog-topic-link inline-block px-1 py-2 underline-offset-4',
              state === 'inactive' && 'text-black no-underline dark:text-white',
              state !== 'inactive' && 'font-semibold text-lt-purple underline decoration-2 dark:text-wheat',
            ]}
          >
            {link.label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  @media (hover: hover) {
    .blog-topic-link[aria-current]:hover {
      text-decoration-thickness: 4px;
    }
  }
</style>
