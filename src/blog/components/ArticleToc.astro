---
import type { TocItem } from '../utils/articleToc.ts';
const { items } = Astro.props as { items: TocItem[] };
---

{items.length >= 3 && <nav aria-labelledby="article-toc-heading" class="my-8 border-2 border-lt-code-border bg-lt-code-bg p-4 dark:border-dk-code-border dark:bg-dk-code-bg"><h2 id="article-toc-heading" class="m-0 text-lg">On this page</h2><ul class="mt-3 grid gap-1 p-0" role="list">{items.map((item) => <li><a href={`#${item.id}`} class="text-base underline hover:no-underline">{item.label}</a></li>)}</ul></nav>}
