---
import dayjs from 'dayjs';
import type { BlogArticleListing } from '../interfaces/article.ts';
import { getBlogArticlePath } from '../routes.ts';
import { getBlogCategoryByDrupalName } from '../categories.ts';

const { posts, emptyMessage = 'No posts have been published in this section yet.', headingLevel = 2 } = Astro.props as {
  posts: BlogArticleListing[];
  emptyMessage?: string;
  headingLevel?: 2 | 3;
};
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

{posts.length === 0 ? (
  <p class="rounded-xl border border-black/20 bg-white/80 p-6 text-center dark:border-white/30 dark:bg-black/30">
    {emptyMessage}
  </p>
) : (
  <ul class="grid grid-cols-1 gap-6 p-0 md:grid-cols-2 lg:grid-cols-3" role="list">
    {posts.map((post) => {
      const category = getBlogCategoryByDrupalName(post.category, post.title);
      return (
        <li class="blog-cover-card blog-gradient-border group relative grid content-start bg-lt-blue-light p-2 transition-shadow hover:shadow-lg focus-within:shadow-lg dark:bg-dk-purple dark:text-white">
          <img src={post.listingImage} alt="" width="690" height="404" loading="lazy" class="aspect-[690/404] w-full object-cover">
          <div class="p-3 text-center">
            <Heading class="m-0 text-xl font-semibold leading-tight lg:text-2xl">
              <a class="blog-card-link blog-cover-link no-underline" href={getBlogArticlePath(category, post.slug, post.title)}>
                <span class="blog-card-title">{post.title}</span>
              </a>
            </Heading>
            <p class="mt-3 text-base">
              {dayjs(post.date).format('MMMM DD, YYYY')} <span aria-hidden="true">|</span>{' '}
              <span class="sr-only">in category </span>{category.label}
            </p>
            <p class="mt-3 text-base leading-relaxed">{post.metaDescription}</p>
          </div>
        </li>
      );
    })}
  </ul>
)}
