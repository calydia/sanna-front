---
import dayjs from 'dayjs';
import type { BlogArticleListing } from '../interfaces/article.ts';
import { getBlogArticlePath, getBlogCategoryPath } from '../routes.ts';
import { getBlogCategoryByDrupalName } from '../categories.ts';

const { posts, emptyMessage = 'No posts have been published in this section yet.' } = Astro.props as {
  posts: BlogArticleListing[];
  emptyMessage?: string;
};
---

{posts.length === 0 ? (
  <p class="rounded-xl border border-black/20 bg-white/80 p-6 text-center dark:border-white/30 dark:bg-black/30">
    {emptyMessage}
  </p>
) : (
  <ul class="grid grid-cols-1 gap-6 p-0 md:grid-cols-2 lg:grid-cols-3" role="list">
    {posts.map((post) => {
      const category = getBlogCategoryByDrupalName(post.category, post.title);
      return (
        <li class="relative grid content-start border-4 border-lt-blue-dark bg-lt-blue-light p-2 transition-shadow hover:shadow-lg focus-within:shadow-lg dark:border-dk-blue-light dark:bg-dk-purple dark:text-white">
          <img src={post.listingImage} alt="" width="690" height="404" loading="lazy" class="aspect-[690/404] w-full object-cover">
          <div class="p-3 text-center">
            <h2 class="m-0 text-xl font-semibold leading-tight lg:text-2xl">
              <a class="blog-card-link underline decoration-2 underline-offset-4" href={getBlogArticlePath(category, post.slug, post.title)}>
                {post.title}
              </a>
            </h2>
            <p class="mt-3 text-base">
              {dayjs(post.date).format('MMMM DD, YYYY')} <span aria-hidden="true">|</span>{' '}
              <a class="relative z-10 underline hover:no-underline" href={getBlogCategoryPath(category)}>{category.label}</a>
            </p>
            <p class="mt-3 text-base leading-relaxed">{post.metaDescription}</p>
          </div>
        </li>
      );
    })}
  </ul>
)}
