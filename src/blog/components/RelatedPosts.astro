---
import type { BlogArticleListing } from '../interfaces/article.ts';
import { getBlogArticlePath } from '../routes.ts';
const { posts } = Astro.props as { posts: BlogArticleListing[] };
---

{posts.length > 0 && <section aria-labelledby="related-posts" class="mt-12 border-t-4 border-lt-blue-dark pt-6 dark:border-dk-blue-light"><h2 id="related-posts" class="text-2xl lg:text-3xl">Related posts</h2><ul class="mt-5 grid gap-6 p-0 md:grid-cols-3" role="list">{posts.map((post) => <li class="blog-cover-card relative"><img src={post.listingImage} alt="" width="690" height="404" loading="lazy"><a href={getBlogArticlePath(post.category, post.slug, post.title)} class="blog-card-link blog-cover-link mt-2 block font-semibold no-underline"><span class="blog-card-title">{post.title}</span></a></li>)}</ul></section>}
