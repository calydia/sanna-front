---
import { Icon } from 'astro-icon/components';

const { currentPage, totalPages, getPageUrl } = Astro.props as {
  currentPage: number;
  totalPages: number;
  getPageUrl: (page: number) => string;
};
const pages = Array.from({ length: totalPages }, (_, index) => index + 1);
---

{totalPages > 1 && (
  <nav class="mt-8 text-base md:mt-10" aria-label="Pagination">
    <ul class="flex flex-wrap items-center justify-center gap-2 p-0" role="list">
      {currentPage > 1 && <li><a class="blog-pager-link blog-pager-previous inline-flex min-h-11 items-center gap-2 rounded-sm border-2 border-lt-blue-dark px-4 py-2 font-semibold text-lt-blue-dark no-underline dark:border-dk-blue-light dark:text-dk-blue-light" href={getPageUrl(currentPage - 1)} rel="prev"><Icon name="arrow-left" class="blog-pager-arrow h-6 w-6 shrink-0" aria-hidden="true" /> Previous</a></li>}
      {pages.map((page) => <li>{page === currentPage
        ? <span class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-sm bg-lt-blue-dark px-3 py-2 font-bold text-white dark:bg-dk-blue-light dark:text-dk-purple" aria-current="page"><span class="sr-only">Page </span>{page}</span>
        : <a class="blog-pager-link inline-flex min-h-11 min-w-11 items-center justify-center rounded-sm border-2 border-lt-blue-dark px-3 py-2 font-semibold text-lt-blue-dark no-underline dark:border-dk-blue-light dark:text-dk-blue-light" href={getPageUrl(page)} aria-label={`Page ${page}`}>{page}</a>
      }</li>)}
      {currentPage < totalPages && <li><a class="blog-pager-link blog-pager-next inline-flex min-h-11 items-center gap-2 rounded-sm border-2 border-lt-blue-dark px-4 py-2 font-semibold text-lt-blue-dark no-underline dark:border-dk-blue-light dark:text-dk-blue-light" href={getPageUrl(currentPage + 1)} rel="next">Next <Icon name="arrow-right" class="blog-pager-arrow h-6 w-6 shrink-0" aria-hidden="true" /></a></li>}
    </ul>
  </nav>
)}

<style>
  .blog-pager-arrow {
    transition: transform 150ms ease-in-out;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .blog-pager-link:hover {
      background: #dfe7fc;
    }

    :global(.dark) .blog-pager-link:hover {
      background: #070038;
    }

    .blog-pager-previous:hover .blog-pager-arrow {
      transform: translateX(-2px);
    }

    .blog-pager-next:hover .blog-pager-arrow {
      transform: translateX(2px);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: reduce) {
    .blog-pager-link:hover {
      background: #dfe7fc;
    }

    :global(.dark) .blog-pager-link:hover {
      background: #070038;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-pager-arrow {
      transition: none;
    }
  }

  .blog-pager-link:focus {
    outline-offset: 4px;
  }
</style>
