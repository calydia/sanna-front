---
import SiteLayout from '../../layouts/SiteLayout.astro';
import BlogTopicNavigation from '../components/BlogTopicNavigation.astro';

type Props = {
  title: string;
  metaDescription: string;
  fiUrl?: string;
  enUrl?: string;
  canonicalPath?: string;
  image?: string;
};

const {
  title,
  metaDescription,
  fiUrl = '/fi/blog/',
  enUrl = Astro.url.pathname,
  canonicalPath = Astro.url.pathname,
  image = '/sanna-profile.jpg',
} = Astro.props;
const canonicalUrl = new URL(canonicalPath, Astro.site).toString();
const isBlogHomepage = Astro.url.pathname === '/blog/';
---

<SiteLayout
  title={title}
  metaDescription={metaDescription}
  language="en"
  fiUrl={fiUrl}
  enUrl={enUrl}
  showBreadcrumb={false}
  bodyAppearance="blog"
  showLanguageSwitcher={isBlogHomepage}
  languageLinkText="Tietoa blogista suomeksi"
>
  <Fragment slot="head">
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:image" content={new URL(image, Astro.site)}>
    <link rel="canonical" href={canonicalUrl}>
    <link rel="alternate" type="application/rss+xml" title="Sanna Kramsi – Blog" href="/blog/rss.xml">
    <slot name="head" />
  </Fragment>
  <div class="blog-shell space-y-8 text-lg text-lt-gray dark:text-dk-gray lg:text-xl">
    <BlogTopicNavigation />
    <slot />
  </div>
</SiteLayout>

<style is:global>
  .blog-shell a:not([class*="text-"]) {
    color: #033573;
  }

  .dark .blog-shell a:not([class*="text-"]) {
    color: #ade5f8;
  }

  @media (hover: hover) {
    .blog-shell a:hover {
      color: #54007b;
      text-decoration-line: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 4px;
    }

    .dark .blog-shell a:hover {
      color: #f5deb3;
    }
  }

  .blog-shell a:focus {
    color: #54007b;
    text-decoration-line: none;
    outline: 2px solid #54007b;
    outline-offset: 2px;
  }

  .dark .blog-shell a:focus {
    color: #f5deb3;
    outline-color: #f5deb3;
  }

  .blog-gradient-border {
    border: 4px solid;
    border-image: linear-gradient(90deg, #46037e 0%, #4169e1 50%, #46037e 100%) 1;
  }

  .blog-cover-card:focus-within {
    outline: 4px solid #111;
    outline-offset: 4px;
  }

  .dark .blog-cover-card:focus-within {
    outline-color: #fff;
  }

  .blog-shell .blog-cover-link:focus {
    color: inherit;
    outline: none;
  }

  @media (hover: hover) {
    .blog-cover-card:hover .blog-card-title {
      color: #54007b;
      text-decoration-line: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 4px;
    }

    .dark .blog-cover-card:hover .blog-card-title {
      color: #ade5f8;
    }
  }

  .blog-tag-link {
    text-decoration-line: none;
  }

  @media (hover: hover) {
    .blog-shell .blog-tag-link:hover {
      border-color: #54007b;
    }

    .dark .blog-shell .blog-tag-link:hover {
      border-color: #f5deb3;
    }
  }

  .blog-button {
    border: 4px solid transparent;
    background: #033573;
    color: #fff !important;
    transition: color 300ms ease-in-out, background-color 300ms ease-in-out, border-color 300ms ease-in-out;
  }

  .dark .blog-button {
    background: #ade5f8;
    color: #000 !important;
  }

  @media (hover: hover) {
    .blog-shell .blog-button:hover {
      border-color: #033573;
      background: transparent;
      color: #033573 !important;
    }

    .dark .blog-shell .blog-button:hover {
      border-color: #ade5f8;
      color: #ade5f8 !important;
    }
  }

  .blog-shell .blog-button:focus {
    color: #fff;
    outline: 2px solid #000;
    outline-offset: 4px;
  }

  .dark .blog-shell .blog-button:focus {
    color: #000;
    outline-color: #fff;
  }

  .blog-shell .blog-body p {
    margin-block: 1.5rem;
    line-height: 1.625;
  }

  .blog-shell .blog-body a {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  @media (hover: hover) {
    .blog-shell .blog-body a:hover {
      text-decoration-thickness: 2px;
    }
  }

  .blog-shell .blog-body h2 {
    margin-top: 2.5rem;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .blog-shell .blog-body h3 {
    margin-top: 2rem;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .blog-shell .blog-body blockquote {
    margin-block: 2rem;
    border-left: 0.5rem solid #54007b;
    background: #e2e8f0;
    padding: 1.5rem;
  }

  .dark .blog-shell .blog-body blockquote {
    border-left-color: #ade5f8;
    background: #0f172a;
  }

  .blog-shell .blog-body code {
    border: 1px solid #bbc9f7;
    background: #dfe7fc;
    padding: 0.125rem 0.25rem;
    font-size: 1rem;
  }

  .dark .blog-shell .blog-body code {
    border-color: #18399a;
    background: #070038;
  }

  .blog-shell .blog-body a[href^="http://"]::after,
  .blog-shell .blog-body a[href^="https://"]::after {
    content: '';
    display: inline-block;
    width: 1.5rem;
    height: 1.5rem;
    background: url('/icons/external-link-light.svg') right bottom / 1.25rem 1.25rem no-repeat;
    vertical-align: text-bottom;
  }

  .dark .blog-shell .blog-body a[href^="http://"]::after,
  .dark .blog-shell .blog-body a[href^="https://"]::after {
    background-image: url('/icons/external-link-dark.svg');
  }

  @media (min-width: 64rem) {
    .blog-shell .blog-body h2 { font-size: 1.875rem; }
    .blog-shell .blog-body h3 { font-size: 1.5rem; }
  }

  .blog-card-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
</style>
